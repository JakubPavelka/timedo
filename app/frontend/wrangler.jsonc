{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "timedo-fe",
    "compatibility_date": "2026-09-03",
    "workers_dev": false,
    "preview_urls": false,
    "routes": [
        {
            "pattern": "app.timedo.cz",
            "custom_domain": true,
        },
    ],
    "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application",
    },
}
